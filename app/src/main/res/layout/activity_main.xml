<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Header, as in the stock tools: back chevron on the left, small centred title. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/btnBack"
            android:focusable="false"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="Back"
            android:paddingBottom="14dp"
            android:paddingLeft="19dp"
            android:paddingRight="19dp"
            android:paddingTop="14dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:maxWidth="260dp"
            android:text="Lookup"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Type what it is. -->
        <LinearLayout
            android:id="@+id/homePane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="31dp"
            android:paddingRight="31dp">

            <EditText
                android:id="@+id/queryField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="What is it?"
                android:imeOptions="actionSearch"
                android:inputType="text|textNoSuggestions"
                android:maxLines="3"
                android:padding="0dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E6E6E"
                android:textSize="28sp" />

            <!-- Earlier searches, newest first; typing narrows them. -->
            <ListView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- Sold and listed prices. -->
        <LinearLayout
            android:id="@+id/resultsPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="12dp"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:paddingTop="8dp"
                android:textColor="#9A9A9A"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- One listing: its pictures, price and title. -->
        <LinearLayout
            android:id="@+id/detailPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:focusable="false"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/detailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:paddingTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:paddingBottom="4dp"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detailCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingBottom="8dp"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:textColor="#9A9A9A"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <WebView
            android:id="@+id/scraper"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <WebView
            android:id="@+id/scraperActive"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Bottom row, as in the stock editors: an action in each corner. -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/btnLeft"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:contentDescription="Photo"
            android:paddingLeft="31dp"
            android:paddingRight="24dp"
            android:src="@drawable/ic_camera" />

        <TextView
            android:id="@+id/labelLeft"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center_vertical"
            android:paddingLeft="31dp"
            android:paddingRight="24dp"
            android:text="SOLD"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnRight"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:contentDescription="Search"
            android:paddingLeft="24dp"
            android:paddingRight="31dp"
            android:src="@drawable/ic_search" />

        <TextView
            android:id="@+id/labelRight"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:paddingLeft="24dp"
            android:paddingRight="31dp"
            android:text="LISTED"
            android:textColor="#6E6E6E"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
